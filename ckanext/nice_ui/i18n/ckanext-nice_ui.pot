msgid "Three poles, one continuous cycle"
msgstr ""

#: ckanext/nice_ui/templates/home/about.html:52
msgid ""
"The activities do not work in silos: they exchange matter, energy and "
"value."
msgstr ""

#: ckanext/nice_ui/templates/home/about.html:56
msgid "Livestock and protein"
msgstr ""

#: ckanext/nice_ui/templates/home/about.html:57
